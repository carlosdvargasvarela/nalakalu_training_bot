{
  "name": "nalakalu",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @nalakalu/db && npm run build -w @nalakalu/mcp-documents && npm run build -w @nalakalu/mcp-workers && npm run build -w @nalakalu/mcp-admin && npm run build -w @nalakalu/gateway",
    "dev": "concurrently \"npm run dev -w @nalakalu/gateway\" \"npm run dev -w @nalakalu/frontend\"",
    "test": "npm run test --workspaces --if-present",
    "db:migrate": "npm run migrate -w @nalakalu/db"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@nalakalu/db": "^0.1.0",
    "@nalakalu/gateway": "^0.1.0",
    "@nalakalu/mcp-admin": "^0.1.0",
    "@nalakalu/mcp-documents": "^0.1.0",
    "@nalakalu/mcp-workers": "^0.1.0",
    "dotenv": "^17.4.2"
  }
}
