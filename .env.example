# PostgreSQL
DATABASE_URL=postgresql://nalakalu:POSTGRES_PASSWORD@localhost:5432/nalakalu
POSTGRES_PASSWORD=cambia_esto_en_produccion

# Cloudflare R2
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET_NAME=nalakalu-docs
R2_PUBLIC_URL=https://your-bucket.r2.dev

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...    

# Gateway
GATEWAY_PORT=3001
ADMIN_SECRET=cambia_esto_en_produccion

# Frontend
NEXT_PUBLIC_GATEWAY_URL=http://localhost:3001

# Producción (solo docker-compose.prod.yml)
DOMAIN=nalakalu.tuempresa.com
